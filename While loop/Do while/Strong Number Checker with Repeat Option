import math

while True:
    num = int(input("Enter number: "))
    temp = num
    total = 0

    while temp > 0:
        digit = temp % 10
        total += math.factorial(digit)
        temp //= 10

    if total == num:
        print("Strong Number")
    else:
        print("Not Strong Number")

    ch = input("Continue? (y/n): ")
    if ch.lower() != 'y':
        break
